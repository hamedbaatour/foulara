# Copy to .env. Never commit .env or paste the password into the storefront.
# Gmail sending accounts require an app password with 2-Step Verification enabled.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASSWORD=
# Optional: defaults to SMTP_USER. Must be allowed by your sending account.
SMTP_FROM=
PORT=4180
HOST=127.0.0.1
# The recipient is fixed server-side to mouyahama@gmail.com.
